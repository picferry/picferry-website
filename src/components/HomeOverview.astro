---
interface Props {
  locale?: 'zh-CN' | 'en';
}

const { locale = 'zh-CN' } = Astro.props;
const en = locale === 'en';
const base = en ? '/en/' : '/';
const text = en ? {
  connected: 'App integrated',
  connectedNote: 'Connect an account to browse and save your media.',
  core: 'Not supported yet',
  coreNote: 'Adding these accounts is not available in the App yet.',
  unstable: 'Not available yet',
  capabilities: 'From cloud gallery to your device',
  introduction: 'Start with a few items. Keep cloud originals until you have checked your local copies.',
} : {
  connected: 'App 已接入',
  connectedNote: '连接账号，即可浏览并保存云端媒体。',
  core: '暂未支持',
  coreNote: 'App 暂未开放新增这些账号。',
  unstable: '暂未开放',
  capabilities: '从云端浏览，到本机保存',
  introduction: '先试存少量照片和视频，确认本地副本可用，再决定是否释放云空间。',
};

// 顺序与 App「添加账号」一致：父品牌后紧跟使用同一云服务的入口。
const groups = [
  {
    id: 'connected-services',
    title: text.connected,
    note: text.connectedNote,
    connected: true,
    vendors: [
      { id: 'icloud', name: 'iCloud', description: en ? 'Apple ID, two-factor authentication, and mainland China accounts. Browse, download, and move after verification.' : 'Apple ID、双重认证与中国大陆区；浏览、下载及通过校验后的迁移。' },
      { id: 'xiaomi', name: 'Xiaomi', description: en ? 'Browse albums, save originals, and move media. Sign-in depends on your OS.' : '浏览云相册、保存原件与迁移媒体；按系统使用网页登录或 Cookie。' },
      { id: 'xiaomi', name: 'REDMI', description: en ? 'Uses the same Xiaomi cloud service. The account is stored as Xiaomi.' : '使用同一小米云服务，账号按小米保存。' },
      { id: 'xiaomi', name: 'POCO', description: en ? 'Uses the same Xiaomi cloud service. The account is stored as Xiaomi.' : '使用同一小米云服务，账号按小米保存。' },
      { id: 'vivo', name: 'vivo', description: en ? 'Browse and save cloud media. Moves require a suite session.' : '浏览并保存云端媒体；迁移需要 suite 会话。' },
      { id: 'vivo', name: 'iQOO', description: en ? 'Uses the same vivo cloud service. The account is stored as vivo.' : '使用同一 vivo 云服务，账号按 vivo 保存。' },
      { id: 'oppo', name: 'OPPO', description: en ? 'Official web sign-in, browsing, saving, and individual deletion. Batch moves are not enabled.' : '官方网页登录后浏览、保存，并支持图库单项删除；批量迁移未开放。' },
      { id: 'oppo', name: 'OnePlus', description: en ? 'Uses the same OPPO cloud service. The account is stored as OPPO.' : '使用同一 OPPO 云服务，账号按 OPPO 保存。' },
      { id: 'oppo', name: 'realme', description: en ? 'Uses the same OPPO cloud service. The account is stored as OPPO.' : '使用同一 OPPO 云服务，账号按 OPPO 保存。' },
    ],
  },
  {
    id: 'core-services',
    title: text.core,
    note: text.coreNote,
    connected: false,
    vendors: [
      { id: 'huawei', name: 'HUAWEI' },
      { id: 'honor', name: 'HONOR' },
    ],
  },
];

const steps = en ? [
  { title: 'Browse your gallery', description: 'Connect an account, explore albums and preview images. Save a few items first to check the result.', link: 'getting-started/', action: 'Get started' },
  { title: 'Save to your device', description: 'Keep originals in the cloud with copy mode. Save to desktop folders or the system media library on Android, iOS and HarmonyOS.', link: 'guides/gui/', action: 'Choose how to save' },
  { title: 'Migrate when ready', description: 'Migration deletes cloud items only after its checks pass. Direct gallery deletion is separate and does not require a backup.', link: 'security/', action: 'Understand deletion' },
] : [
  { title: '浏览云端相册', description: '连接账号，浏览相册与图片预览。先试存少量媒体，确认内容和保存位置符合预期。', link: 'getting-started/', action: '开始使用' },
  { title: '保存到自己的设备', description: '默认“仅下载”，保留云端原件。桌面保存到本地目录，Android、iOS 和 HarmonyOS 保存到系统图库。', link: 'guides/gui/', action: '了解保存方式' },
  { title: '确认后，按需迁移', description: '迁移通过校验后才删除对应云端内容。图库直接删除是独立操作，确认后即可执行，请谨慎确认。', link: 'security/', action: '了解删除边界' },
];
---

<div class="home-overview not-content">
  <div class="service-columns">
    {groups.map((group) => (
      group.connected ? (
        <section class="service-group" aria-labelledby={group.id}>
          <header class="service-group-heading">
            <h3 id={group.id}>{group.title}</h3>
            <p>{group.note}</p>
          </header>
          <ul class="service-list connected-list" role="list">
            {group.vendors.map((vendor) => (
              <li>
                <a class="service-row" href={`${base}guides/${vendor.id}/`}>
                  <span class="service-name">{vendor.name}</span>
                  {vendor.description && <span>{vendor.description}</span>}
                </a>
              </li>
            ))}
          </ul>
        </section>
      ) : (
        <details class="service-group pending-group">
          <summary>
            <span class="service-group-heading">
              <span class="summary-title" id={group.id}>{group.title}</span>
              <span class="summary-names">{group.vendors.map((vendor) => vendor.name).join(en ? ', ' : '、')}</span>
            </span>
          </summary>
          <p class="pending-note">{group.note}</p>
          <ul class="service-list" role="list">
            {group.vendors.map((vendor) => (
              <li>
                <a class="service-card" href={`${base}guides/${vendor.id}/`}>
                  <span class="service-heading">
                    <span class="service-name">{vendor.name}</span>
                    <span class="service-badges">
                      <span class="service-badge implemented">{group.title}</span>
                      <span class="service-badge unstable">{text.unstable}</span>
                    </span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      )
    ))}
  </div>

  <section class="capabilities" aria-labelledby="capabilities-heading">
    <header class="capabilities-heading">
      <h2 id="capabilities-heading">{text.capabilities}</h2>
      <p>{text.introduction}</p>
    </header>
    <ol class="workflow" role="list">
      {steps.map((step, index) => (
        <li class="workflow-step">
          <span class="step-number" aria-hidden="true">{String(index + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
          <a href={`${base}${step.link}`}>{step.action}<span aria-hidden="true"> →</span></a>
        </li>
      ))}
    </ol>
  </section>
</div>

<style>
  .home-overview {
    --overview-surface: var(--sl-color-bg-nav);
    --overview-muted: var(--sl-color-gray-2);
    margin-block: 1.5rem 2.5rem;
  }
  .home-overview :is(h2, h3, p, ul, ol) { margin: 0; }
  .service-columns { display: grid; gap: 2rem; }
  .service-group { min-width: 0; }
  .service-group-heading { margin-bottom: 1rem; }
  h3, .summary-title { font-size: 1.125rem; line-height: 1.5; font-weight: 600; }
  .pending-group { border-block-start: 1px solid var(--sl-color-gray-5); }
  .pending-group > summary {
    display: flex;
    align-items: center;
    min-height: 3rem;
    cursor: pointer;
    list-style: none;
  }
  .pending-group > summary::-webkit-details-marker { display: none; }
  .pending-group > summary::after {
    content: '';
    width: .5rem;
    height: .5rem;
    margin-inline-start: auto;
    border-inline-end: 2px solid currentColor;
    border-block-end: 2px solid currentColor;
    transform: rotate(45deg);
  }
  .pending-group[open] > summary::after { transform: rotate(225deg); }
  .pending-group .service-group-heading { display: grid; gap: .25rem; margin: 0; }
  .summary-names { color: var(--overview-muted); font-size: .875rem; line-height: 1.5; }
  .pending-note { margin: .5rem 0 1rem; color: var(--overview-muted); }
  .pending-group > summary:focus-visible { outline: 3px solid var(--sl-color-text-accent); outline-offset: 4px; }
  .service-group-heading p, .capabilities-heading p { margin-top: .5rem; color: var(--overview-muted); }
  .service-list, .workflow { padding: 0; list-style: none; display: grid; gap: 1rem; }
  .service-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: .75rem;
    padding: 1.25rem;
    height: 100%;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: .875rem;
    background: var(--overview-surface);
    color: var(--sl-color-text);
    text-decoration: none;
    transition: border-color 160ms ease;
  }
  .service-card:hover { border-color: var(--sl-color-text-accent); }
  .service-card:active { border-color: var(--sl-color-text-accent); }
  .connected-list {
    gap: 0;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: .875rem;
    background: var(--overview-surface);
  }
  .service-row {
    display: grid;
    grid-template-columns: minmax(6.5rem, auto) minmax(0, 1fr);
    align-items: center;
    gap: .75rem 1.5rem;
    min-height: 3.5rem;
    padding: .75rem 1.25rem;
    border-block-start: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-text);
    text-decoration: none;
  }
  .connected-list > li:first-child .service-row { border-block-start: 0; }
  .service-row span:last-child { color: var(--overview-muted); line-height: 1.6; }
  .service-row:hover { background: var(--sl-color-gray-6, color-mix(in srgb, var(--sl-color-gray-5) 45%, transparent)); }
  .service-row:focus-visible { outline: 3px solid var(--sl-color-text-accent); outline-offset: -3px; }
  .service-heading { display: flex; flex-wrap: wrap; align-items: center; gap: .5rem .75rem; }
  .service-name { font-weight: 600; font-size: 1.125rem; line-height: 1.5; }
  .service-badges { display: flex; flex-wrap: wrap; gap: .5rem; }
  .service-badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.75rem;
    padding: .125rem .625rem;
    border-radius: 999px;
    font-size: .75rem;
    line-height: 1.5;
    font-weight: 600;
    white-space: nowrap;
  }
  .integrated { color: #14532d; background: #dcfce7; }
  .implemented { color: #1e3a8a; background: #dbeafe; }
  .unstable { color: #78350f; background: #fef3c7; }
  :global([data-theme='dark']) .integrated { color: #bbf7d0; background: #14532d; }
  :global([data-theme='dark']) .implemented { color: #bfdbfe; background: #1e3a8a; }
  :global([data-theme='dark']) .unstable { color: #fde68a; background: #78350f; }
  .service-card p, .workflow-step p {
    color: var(--overview-muted);
    font-size: 1rem;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }
  .capabilities { margin-top: 3.5rem; }
  h2 { font-size: clamp(1.5rem, 3vw, 2rem); line-height: 1.3; text-wrap: balance; }
  .capabilities-heading { margin-bottom: 1.5rem; max-width: 65ch; }
  .workflow-step {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: .875rem;
  }
  .step-number { color: var(--sl-color-text-accent); font-size: 1.5rem; font-weight: 700; }
  .workflow-step h3 { text-wrap: balance; }
  .workflow-step a { margin-top: auto; }
  .home-overview a:not(.service-card) {
    color: var(--sl-color-text-accent);
    text-underline-offset: .25em;
    padding-block: .5rem;
  }
  .home-overview a:focus-visible { outline: 3px solid var(--sl-color-text-accent); outline-offset: 4px; }
  @media (max-width: 40rem) {
    .service-row { grid-template-columns: minmax(0, 1fr); gap: .25rem; align-items: start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .pending-group > summary::after { transition: none; }
  }
  @media (min-width: 64rem) {
    .workflow { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (prefers-reduced-motion: reduce) {
    .service-card { transition: none; }
  }
</style>
