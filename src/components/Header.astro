---
import config from 'virtual:starlight/user-config';

import LanguageSelect from 'virtual:starlight/components/LanguageSelect';
import Search from 'virtual:starlight/components/Search';
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import SocialIcons from 'virtual:starlight/components/SocialIcons';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';

const shouldRenderSearch =
	config.pagefind || config.components.Search !== '@astrojs/starlight/components/Search.astro';
const en = Astro.locals.starlightRoute.locale === 'en';
const docsHref = en ? '/en/getting-started/' : '/getting-started/';
const docsLabel = en ? 'Docs' : '文档';
const downloadHref = en ? '/en/download/' : '/download/';
const downloadLabel = en ? 'Download app' : '下载应用';
---

<div class="header">
	<div class="title-wrapper sl-flex">
		<SiteTitle />
	</div>
	<div class="search-slot sl-flex print:hidden">
		{shouldRenderSearch && <Search />}
	</div>
	<div class="sl-hidden md:sl-flex print:hidden right-group">
		<nav class="header-links" aria-label={en ? 'Documentation' : '文档'}>
			<a href={docsHref} aria-current={Astro.url.pathname === docsHref ? 'page' : undefined}>{docsLabel}</a>
		</nav>
		<div class="sl-flex social-icons">
			<SocialIcons />
		</div>
		<a class="package-entry" href={downloadHref} aria-current={Astro.url.pathname === downloadHref ? 'page' : undefined}>{downloadLabel}</a>
		<ThemeSelect />
		<LanguageSelect />
	</div>
</div>

<style>
	@layer starlight.core {
		.header {
			display: flex;
			gap: var(--sl-nav-gap);
			justify-content: space-between;
			align-items: center;
			height: 100%;
		}

		.search-slot {
			flex: 1 1 auto;
			min-width: 0;
			justify-content: flex-end;
		}

		.title-wrapper {
			overflow: clip;
			padding: 0.25rem;
			margin: -0.25rem;
			min-width: 0;
			align-items: center;
		}

		.header-links {
			display: none;
			align-items: center;
			gap: 1rem;
		}

		.header-links a {
			display: inline-flex;
			align-items: center;
			height: 2rem;
			padding: 0 0.125rem;
			color: var(--sl-color-text);
			font-size: var(--sl-text-sm);
			font-weight: 600;
			line-height: 2rem;
			text-decoration: none;
			white-space: nowrap;
		}

		.header-links a[aria-current='page'],
		.header-links a:hover {
			color: var(--sl-color-text-accent);
		}

		.header-links a:focus-visible,
		.package-entry:focus-visible {
			outline: 3px solid var(--sl-color-text-accent);
			outline-offset: 2px;
		}

		.package-entry {
			display: none;
			align-items: center;
			height: 2rem;
			padding: 0 0.75rem;
			border: 1px solid var(--sl-color-text-accent);
			border-radius: 0.5rem;
			background: var(--sl-color-accent-low);
			color: var(--sl-color-text-accent);
			font-size: var(--sl-text-sm);
			font-weight: 600;
			line-height: 2rem;
			text-decoration: none;
			white-space: nowrap;
		}

		.package-entry[aria-current='page'] {
			background: var(--sl-color-text-accent);
			color: var(--sl-color-black);
		}

		.right-group,
		.social-icons {
			gap: 1rem;
			align-items: center;
		}

		.right-group {
			height: 2rem;
		}
		.social-icons::after {
			content: '';
			height: 2rem;
			border-inline-end: 1px solid var(--sl-color-gray-5);
		}

		@media (min-width: 50rem) {
			.header-links,
			.package-entry {
				display: flex;
			}

			:global(:root[data-has-sidebar]) {
				--__sidebar-pad: calc(2 * var(--sl-nav-pad-x));
			}
			:global(:root:not([data-has-toc])) {
				--__toc-width: 0rem;
			}
			.header {
				--__sidebar-width: max(0rem, var(--sl-content-inline-start, 0rem) - var(--sl-nav-pad-x));
				--__main-column-fr: calc(
					(
							100% + var(--__sidebar-pad, 0rem) - var(--__toc-width, var(--sl-sidebar-width)) -
								(2 * var(--__toc-width, var(--sl-nav-pad-x))) - var(--sl-content-inline-start, 0rem) -
								var(--sl-content-width)
						) / 2
				);
				display: grid;
				grid-template-columns:
					minmax(
						calc(var(--__sidebar-width) + max(0rem, var(--__main-column-fr) - var(--sl-nav-gap))),
						auto
					)
					1fr
					auto;
				align-content: center;
			}

			.search-slot {
				justify-content: center;
			}
		}
	}
</style>
